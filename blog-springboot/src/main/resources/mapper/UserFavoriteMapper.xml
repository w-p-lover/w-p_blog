<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ican.mapper.UserFavoriteMapper">

    <sql id="Base_Column_List">
        id, user_id, doc_id
    </sql>

    <select id="selectFavoriteIdsByUserId" resultType="java.lang.String">
        SELECT doc_id
        FROM t_user_favorite
        WHERE user_id = #{userId}
    </select>

    <select id="selectByUserIdAndFavoriteId" resultType="com.ican.entity.UserFavorite">
        SELECT
        <include refid="Base_Column_List"/>
        FROM t_user_favorite
        WHERE user_id = #{userId}
        AND doc_id = #{favoriteId}
    </select>

    <select id="selectUserIdsByFavoriteId" resultType="java.lang.Integer">
        SELECT user_id
        FROM t_user_favorite
        WHERE doc_id = #{favoriteId}
    </select>

    <select id="countByFavoriteId" resultType="java.lang.Integer">
        SELECT COUNT(1)
        FROM t_user_favorite
        WHERE doc_id = #{favoriteId}
    </select>
</mapper>
