# 本地开发默认使用 dev profile
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Jasypt
JASYPT_ENCRYPTOR_PASSWORD=replace-with-your-master-password

# MySQL
BLOG_DB_URL=jdbc:mysql://127.0.0.1:3306/blog?serverTimezone=Asia/Shanghai&allowMultiQueries=true&rewriteBatchedStatements=true&useSSL=false&useUnicode=true&characterEncoding=UTF-8
BLOG_DB_HOST=127.0.0.1
BLOG_DB_PORT=3306
BLOG_DB_NAME=blog
BLOG_DB_USERNAME=root
BLOG_DB_PASSWORD=replace-with-your-db-password

# Redis / RabbitMQ
BLOG_REDIS_HOST=127.0.0.1
BLOG_REDIS_PORT=6379
BLOG_REDIS_PASSWORD=replace-with-your-redis-password
BLOG_REDIS_DATABASE=0
BLOG_RABBITMQ_HOST=127.0.0.1
BLOG_RABBITMQ_PORT=5672
BLOG_RABBITMQ_USERNAME=guest
BLOG_RABBITMQ_PASSWORD=replace-with-your-rabbitmq-password

# Mail
BLOG_MAIL_HOST=smtp.qq.com
BLOG_MAIL_USERNAME=replace@example.com
BLOG_MAIL_PASSWORD=replace-with-your-mail-password

# Search / AI
BLOG_ES_URIS=http://127.0.0.1:9200
BLOG_OPENAI_API_KEY=replace-with-your-openai-compatible-key
BLOG_OPENAI_BASE_URL=https://api.deepseek.com
BLOG_OPENAI_CHAT_MODEL=deepseek-chat
BLOG_OPENAI_CHAT_TEMPERATURE=0.7
BLOG_DASHSCOPE_API_KEY=replace-with-your-dashscope-key
BLOG_DASHSCOPE_EMBED_MODEL=text-embedding-v3
BLOG_QDRANT_HOST=127.0.0.1
BLOG_QDRANT_PORT=6334
BLOG_QDRANT_COLLECTION=blog-articles

# Third-party services
BLOG_HEFENG_API_KEY=replace-with-your-hefeng-key
BLOG_HEFENG_BASE_URL=https://pe7byfyfwb.re.qweatherapi.com/
BLOG_GITEE_CLIENT_ID=replace-with-your-gitee-client-id
BLOG_GITEE_CLIENT_SECRET=replace-with-your-gitee-client-secret
BLOG_GITHUB_CLIENT_ID=replace-with-your-github-client-id
BLOG_GITHUB_CLIENT_SECRET=replace-with-your-github-client-secret

# OSS / upload
BLOG_OSS_URL=https://example-bucket.oss-cn-beijing.aliyuncs.com/
BLOG_OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
BLOG_OSS_BUCKET_NAME=replace-me
BLOG_OSS_ACCESS_KEY_ID=replace-with-your-oss-access-key-id
BLOG_OSS_ACCESS_KEY_SECRET=replace-with-your-oss-access-key-secret
BLOG_UPLOAD_LOCAL_URL=http://127.0.0.1:8080/
BLOG_UPLOAD_LOCAL_PATH=/data/blog/upload/

# Site / CORS
BLOG_SITE_HOST=127.0.0.1
BLOG_SITE_BASE_URL=http://127.0.0.1:8080
BLOG_SITE_URL=http://127.0.0.1:5173
BLOG_ADMIN_URL=http://127.0.0.1:5174
BLOG_API_DOC_URL=http://127.0.0.1:8080/doc.html
BLOG_CORS_ORIGIN_1=http://localhost:5173
BLOG_CORS_ORIGIN_2=http://127.0.0.1:5173
BLOG_CORS_ORIGIN_3=http://localhost:5174
BLOG_CORS_ORIGIN_4=http://127.0.0.1:5174
BLOG_CORS_ORIGIN_5=http://localhost:5175
BLOG_CORS_ORIGIN_6=http://127.0.0.1:5175
BLOG_WS_ORIGIN_1=http://localhost:5173
BLOG_WS_ORIGIN_2=http://127.0.0.1:5173

# Runtime tuning
BLOG_SATOKEN_RENEW_THRESHOLD_SECONDS=600
BLOG_SATOKEN_RENEW_TIMEOUT_SECONDS=1800
BLOG_CACHE_L1_MAX_SIZE=1000
BLOG_CACHE_L1_EXPIRE_MINUTES=5
BLOG_CACHE_BLOOM_EXPECTED_INSERTIONS=1000000
BLOG_CACHE_BLOOM_FALSE_PROBABILITY=0.01
BLOG_CACHE_NULL_TTL_MINUTES=5
BLOG_CACHE_TTL_JITTER_MAX_MINUTES=5
BLOG_CACHE_LOCK_WAIT_SECONDS=3
BLOG_CACHE_LOCK_LEASE_SECONDS=10

# Spider / scripts
BLOG_SPIDER_DIR=src/main/resources/static/
BLOG_PYTHON_CMD=python
KNIFE4J_ENABLE=true
